# Python bytecode and test caches
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Local virtual environments and configuration
venv/
.venv/
.env

# Regenerable pipeline output (fixtures live under tests/ instead)
/data/extracted/*
!/data/extracted/.gitkeep
/data/correlated/*
!/data/correlated/.gitkeep
/data/final_reports/*
!/data/final_reports/.gitkeep
/data/raw_reports/*
!/data/raw_reports/.gitkeep

# Locally selected URL manifests for manual end-to-end testing
/data/raw_reports_test/*
!/data/raw_reports_test/.gitkeep

# Sample folder for manual pipeline testing on real collected articles
/data/raw_reports_sample/

# Step 0 collection state (which articles have already been collected) -
# local processing state, not curated knowledge, regenerable from scratch
/data/collection_state.json

# SQLite database files (records, not schema)
/knowledge/threat_intel.db
/knowledge/*.db-journal
/knowledge/*.db-wal
/knowledge/*.db-shm
/knowledge/*.db.bak
/knowledge/*.db.backup

# JSON data files (records, not schema)
/knowledge/actor_aliases.json
/knowledge/sources.json

# Python scripts for populating the database (records, not schema)
/knowledge/migrate_aliases_json_to_db.py
/knowledge/add_actors.py
/knowledge/add_campaigns.py
/knowledge/add_ttps.py
/knowledge/add_domains.py
/knowledge/add_ioc_examples.py
/knowledge/add_false_positives.py
/knowledge/add_actor_details.py
/knowledge/update_domains.py

# Editor recovery files can contain private source or record data
*.swp
